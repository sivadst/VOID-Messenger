{
  "name": "void-messenger",
  "version": "1.0.0",
  "description": "End-to-End Ultra-Minimal Messaging Application",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch server --ext ts --exec ts-node --project server/tsconfig.json server/index.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.25",
    "lucide-react": "^0.364.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.2.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "socket.io": "^4.7.5",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vite": "^5.2.8"
  },
  "type": "module"
}
